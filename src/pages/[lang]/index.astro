---
import type { GetStaticPaths } from 'astro';

import SiteLayout from '~/layouts/SiteLayout.astro';
import Home from '~/components/site/Home.astro';
import JsonLd from '~/components/site/JsonLd.astro';
import { DEFAULT_LOCALE, LOCALES, alternates, t, type Locale } from '~/i18n';

export const getStaticPaths = (() =>
  LOCALES.filter((lang) => lang !== DEFAULT_LOCALE).map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const d = t(lang);
---

<SiteLayout
  lang={lang}
  alternates={alternates('home')}
  metadata={{ title: d.meta.title, description: d.meta.description }}
>
  <JsonLd slot="head" lang={lang} />
  <Home lang={lang} />
</SiteLayout>
