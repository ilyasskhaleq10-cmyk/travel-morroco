---
import type { GetStaticPaths } from 'astro';

import SiteLayout from '~/layouts/SiteLayout.astro';
import CreditsPage from '~/components/site/CreditsPage.astro';
import { DEFAULT_LOCALE, LOCALES, alternates, t, type Locale } from '~/i18n';

export const getStaticPaths = (() =>
  LOCALES.filter((lang) => lang !== DEFAULT_LOCALE).map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const d = t(lang);
---

<SiteLayout
  lang={lang}
  alternates={alternates('credits')}
  metadata={{ title: d.credits.title, description: d.credits.intro, robots: { index: false, follow: true } }}
>
  <CreditsPage lang={lang} />
</SiteLayout>
