---
import type { GetStaticPaths } from 'astro';

import SiteLayout from '~/layouts/SiteLayout.astro';
import TourDetail from '~/components/site/TourDetail.astro';
import JsonLd from '~/components/site/JsonLd.astro';
import { TOURS } from '~/data/tours';
import { DEFAULT_LOCALE, LOCALES, alternates, t, type Locale, type TourId } from '~/i18n';

export const getStaticPaths = (() =>
  LOCALES.filter((lang) => lang !== DEFAULT_LOCALE).flatMap((lang) =>
    TOURS.map((tour) => ({
      params: { lang, slug: t(lang).tours.items[tour.id].slug },
      props: { id: tour.id },
    }))
  )) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const { id } = Astro.props as { id: TourId };
const copy = t(lang).tours.items[id];
---

<SiteLayout
  lang={lang}
  alternates={alternates(id)}
  metadata={{ title: copy.metaTitle, description: copy.metaDescription }}
>
  <JsonLd slot="head" lang={lang} tour={id} />
  <TourDetail lang={lang} id={id} />
</SiteLayout>
