---
import SiteLayout from '~/layouts/SiteLayout.astro';
import { DEFAULT_LOCALE, alternates, path, t } from '~/i18n';

const lang = DEFAULT_LOCALE;
const d = t(lang);
---

<SiteLayout
  lang={lang}
  alternates={alternates('home')}
  metadata={{ title: d.notFound.title, robots: { index: false, follow: false } }}
>
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-24 text-center md:px-6 md:py-32">
    <p class="font-heading text-6xl font-semibold text-primary">404</p>
    <h1 class="mt-4 font-heading text-3xl font-semibold text-heading md:text-4xl">{d.notFound.title}</h1>
    <p class="mt-3 text-muted">{d.notFound.text}</p>
    <a
      href={path('/', lang)}
      class="mt-8 inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-secondary"
    >
      {d.notFound.button}
    </a>
  </section>
</SiteLayout>
