---
import '~/assets/styles/tailwind.css';

import { Font } from 'astro:assets';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import Intersect from '~/components/common/Intersect.astro';

import { ClientRouter } from 'astro:transitions';

import { DEFAULT_LOCALE, LOCALE_INFO, type Locale } from '~/i18n';
import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
  lang?: Locale;
}

const { metadata = {}, lang = DEFAULT_LOCALE } = Astro.props;
const { htmlLang, dir } = LOCALE_INFO[lang];
const isArabic = lang === 'ar';
---

<!doctype html>
<html lang={htmlLang} dir={dir} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    {
      /*
       * Only the fonts the page actually renders with are preloaded: Arabic
       * pages run entirely on Cairo, the others on Inter + Fraunces.
       */
    }
    {
      isArabic ? (
        <Font cssVariable="--font-cairo" preload />
      ) : (
        <>
          <Font cssVariable="--font-inter" preload />
          <Font cssVariable="--font-fraunces" preload />
        </>
      )
    }
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    <ClientRouter fallback="swap" />

    <!-- Extra head content from pages: hreflang links, structured data… -->
    <slot name="head" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight min-h-screen flex flex-col">
    <slot />

    <Intersect />
  </body>
</html>
