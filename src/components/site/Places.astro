---
import Image from '~/components/common/Image.astro';

import aitBenHaddou from '~/assets/images/marruecos/ait-ben-haddou.jpg';
import gargantasTodra from '~/assets/images/marruecos/gargantas-todra.jpg';
import valleDades from '~/assets/images/marruecos/valle-dades.jpg';
import ergChebbiCresta from '~/assets/images/marruecos/erg-chebbi-cresta.jpg';
import valleZiz from '~/assets/images/marruecos/valle-ziz.jpg';
import fezArtesania from '~/assets/images/marruecos/fez-artesania.jpg';
import chefchaouen from '~/assets/images/marruecos/chefchaouen.jpg';
import tangerKasbah from '~/assets/images/marruecos/tanger-kasbah.jpg';

import { t, type Locale } from '~/i18n';

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);

// Same order as `places.items` in every dictionary.
const images = [
  aitBenHaddou,
  gargantasTodra,
  valleDades,
  ergChebbiCresta,
  valleZiz,
  fezArtesania,
  chefchaouen,
  tangerKasbah,
];

// Eight tiles plus one double-width tile make nine column-units, which fills
// exactly three rows of the md grid — a mosaic with no holes in it.
const wide = new Set([0]);
---

<section id="lugares" class="scroll-mt-20 border-y border-sand bg-sand py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold tracking-wide text-primary uppercase">{d.places.tagline}</p>
      <h2 class="mt-2 font-heading text-3xl font-semibold text-heading md:text-4xl">{d.places.title}</h2>
      <p class="mt-3 text-lg text-muted">{d.places.subtitle}</p>
    </header>

    <ul class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
      {
        d.places.items.map((place, index) => (
          <li
            class:list={[
              'group relative isolate aspect-[4/3] overflow-hidden rounded-xl',
              // Twice as wide, same row height, so every row lines up.
              wide.has(index) ? 'md:col-span-2 md:aspect-[8/3]' : '',
            ]}
          >
            <Image
              src={images[index]}
              alt={place.name}
              layout="cover"
              widths={[320, 640, 960, 1280]}
              sizes={wide.has(index) ? '(max-width: 767px) 50vw, 60vw' : '(max-width: 767px) 50vw, 30vw'}
              format="webp"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent" />
            <div class="absolute inset-x-0 bottom-0 p-4">
              <h3 class="font-heading text-base font-semibold text-white md:text-lg">{place.name}</h3>
              <p class="mt-1 text-xs leading-snug text-white/80 md:text-sm">{place.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
