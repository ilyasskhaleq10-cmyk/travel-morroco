---
import { LOCALES, LOCALE_INFO, type Locale } from '~/i18n';

export interface Props {
  current: Locale;
  /** Same page in every language, in LOCALES order. */
  links: { lang: Locale; href: string }[];
  class?: string;
  label: string;
}

const { current, links, class: className = '', label } = Astro.props;
const href = (lang: Locale) => links.find((l) => l.lang === lang)?.href ?? '/';
---

<nav aria-label={label} class:list={['flex items-center gap-0.5', className]}>
  {
    LOCALES.map((lang) => {
      const isCurrent = lang === current;
      return (
        <a
          href={href(lang)}
          hreflang={LOCALE_INFO[lang].hreflang}
          lang={LOCALE_INFO[lang].htmlLang}
          aria-current={isCurrent ? 'true' : undefined}
          title={LOCALE_INFO[lang].native}
          class:list={[
            'rounded-md px-1.5 py-1 text-xs font-semibold uppercase tracking-wide transition-colors',
            isCurrent
              ? 'bg-primary/12 text-primary dark:bg-primary/20'
              : 'text-muted hover:bg-black/5 hover:text-heading dark:hover:bg-white/10',
          ]}
        >
          {LOCALE_INFO[lang].short}
        </a>
      );
    })
  }
</nav>
