---
import { Icon } from 'astro-icon/components';
import { t, type Locale } from '~/i18n';

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);

const icons = [
  'tabler:users-group',
  'tabler:mountain',
  'tabler:tent',
  'tabler:language',
  'tabler:list-check',
  'tabler:message-2-exclamation',
];
---

<section id="porque" class="scroll-mt-20 border-y border-sand bg-sand py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold tracking-wide text-primary uppercase">{d.why.tagline}</p>
      <h2 class="mt-2 font-heading text-3xl font-semibold text-heading md:text-4xl">{d.why.title}</h2>
      <p class="mt-3 text-lg text-muted">{d.why.subtitle}</p>
    </header>

    <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        d.why.items.map((item, index) => (
          <li class="rounded-2xl border border-sand bg-page p-6">
            <Icon name={icons[index]} class="h-7 w-7 text-primary" aria-hidden="true" />
            <h3 class="mt-4 font-heading text-lg font-semibold text-heading">{item.title}</h3>
            <p class="mt-2 text-sm text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
