---
import { PHOTO_CREDITS } from '~/data/photo-credits';
import { t, type Locale } from '~/i18n';

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section class="mx-auto max-w-4xl px-4 py-16 md:px-6 md:py-24">
  <h1 class="font-heading text-3xl font-semibold text-heading md:text-4xl">{d.credits.title}</h1>
  <p class="mt-3 text-muted">{d.credits.intro}</p>

  <ul class="mt-8 divide-y divide-sand border-y border-sand">
    {
      PHOTO_CREDITS.map((credit) => (
        <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
          <span class="font-medium text-heading" dir="ltr">
            {credit.file}
          </span>
          <span class="text-sm text-muted" dir="ltr">
            {credit.author} ·{' '}
            {credit.licenseUrl ? (
              <a href={credit.licenseUrl} rel="license noopener noreferrer" target="_blank" class="hover:text-primary">
                {credit.license}
              </a>
            ) : (
              credit.license
            )}{' '}
            ·{' '}
            <a href={credit.source} rel="noopener noreferrer" target="_blank" class="hover:text-primary">
              Wikimedia Commons
            </a>
          </span>
        </li>
      ))
    }
  </ul>
</section>
