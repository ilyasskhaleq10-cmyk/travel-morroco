---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';

import { BUSINESS, whatsappLink } from '~/config/business';
import { TOURS } from '~/data/tours';
import { t, tourPath, fillTemplate, type Locale } from '~/i18n';

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const d = t(lang);
---

<section id="tours" class="scroll-mt-20 py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <header class="max-w-3xl">
      <p class="text-sm font-semibold tracking-wide text-primary uppercase">{d.tours.tagline}</p>
      <h2 class="mt-2 font-heading text-3xl font-semibold text-heading md:text-4xl">{d.tours.title}</h2>
      <p class="mt-3 text-lg text-muted">{d.tours.subtitle}</p>
    </header>

    <ul class="mt-10 grid gap-6 lg:grid-cols-3">
      {
        TOURS.map((tour) => {
          const copy = d.tours.items[tour.id];
          const href = tourPath(tour.id, lang);
          const stops = copy.route.split(/\s*[→←]\s*/);
          return (
            <li class="group flex flex-col overflow-hidden rounded-2xl border border-sand bg-page shadow-sm transition-shadow hover:shadow-xl">
              <a href={href} class="relative block aspect-[4/3] overflow-hidden">
                <Image
                  src={tour.image}
                  alt={copy.name}
                  layout="cover"
                  widths={[400, 640, 900]}
                  sizes="(max-width: 1023px) 100vw, 400px"
                  format="webp"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <span class="absolute top-3 start-3 rounded-full bg-black/65 px-3 py-1 text-xs font-semibold text-white backdrop-blur-sm">
                  {copy.duration}
                </span>
              </a>

              <div class="flex flex-1 flex-col p-5">
                <h3 class="font-heading text-xl leading-snug font-semibold text-heading">
                  <a href={href} class="transition-colors hover:text-primary">
                    {copy.name}
                  </a>
                </h3>

                <ol class="mt-3 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-muted">
                  {stops.map((stop, index) => (
                    <>
                      {index > 0 && (
                        <Icon
                          name="tabler:chevron-right"
                          class="rtl-flip h-3.5 w-3.5 text-primary/60"
                          aria-hidden="true"
                        />
                      )}
                      <li>{stop}</li>
                    </>
                  ))}
                </ol>

                <p class="mt-3 text-sm text-muted">{copy.summary}</p>

                <ul class="mt-4 flex flex-wrap gap-1.5">
                  {copy.highlights.map((highlight) => (
                    <li class="rounded-full bg-sand px-2.5 py-1 text-xs text-default">{highlight}</li>
                  ))}
                </ul>

                <div class="mt-auto pt-5">
                  <p class="font-heading text-lg font-semibold text-heading">
                    {tour.price === null ? (
                      <span class="text-base font-medium text-muted">{d.common.onRequest}</span>
                    ) : (
                      <>
                        <span class="text-sm font-medium text-muted">{d.common.from}</span>{' '}
                        <span dir="ltr">
                          {tour.price}
                          {BUSINESS.currencySymbol}
                        </span>{' '}
                        <span class="text-sm font-medium text-muted">{d.common.perPerson}</span>
                      </>
                    )}
                  </p>

                  <div class="mt-3 flex flex-col gap-2 sm:flex-row">
                    <a
                      href={href}
                      class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-full border border-sand px-4 py-2.5 text-sm font-semibold text-heading transition-colors hover:border-primary hover:text-primary"
                    >
                      {d.common.viewItinerary}
                    </a>
                    <a
                      href={whatsappLink(fillTemplate(d.common.whatsappMessage, { tour: copy.name }))}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${d.common.whatsapp} — ${copy.shortName}`}
                      class="inline-flex items-center justify-center gap-1.5 rounded-full bg-primary px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-secondary"
                    >
                      <Icon name="tabler:brand-whatsapp" class="h-4 w-4" aria-hidden="true" />
                      {d.common.bookNow}
                    </a>
                  </div>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
