---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';

import CtaBand from './CtaBand.astro';

import { BUSINESS, whatsappLink } from '~/config/business';
import { TOURS, getTour } from '~/data/tours';
import { t, tourPath, homeAnchor, fillTemplate, type Locale, type TourId } from '~/i18n';

export interface Props {
  lang: Locale;
  id: TourId;
}

const { lang, id } = Astro.props;
const d = t(lang);
const tour = getTour(id);
const copy = d.tours.items[id];
const whatsapp = whatsappLink(fillTemplate(d.common.whatsappMessage, { tour: copy.name }));
const others = TOURS.filter((item) => item.id !== id);
---

<article>
  <header class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10">
      <Image
        src={tour.image}
        alt=""
        layout="cover"
        loading="eager"
        fetchpriority="high"
        widths={[640, 1024, 1600, 2048]}
        sizes="100vw"
        format="webp"
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/65 via-black/40 to-black/80"></div>
    </div>

    <div class="mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-24">
      <a
        href={homeAnchor('tours', lang)}
        class="flex w-fit items-center gap-1.5 text-sm font-medium text-white/80 transition-colors hover:text-white"
      >
        <Icon name="tabler:arrow-left" class="rtl-flip h-4 w-4" aria-hidden="true" />
        {d.common.backToTours}
      </a>

      <p
        class="mt-6 flex w-fit items-center gap-2 rounded-full border border-white/25 bg-white/10 px-3 py-1 text-xs font-semibold text-white backdrop-blur-sm"
      >
        <Icon name="tabler:calendar" class="h-3.5 w-3.5" aria-hidden="true" />
        {copy.duration}
      </p>

      <h1
        class="text-shadow-photo mt-4 max-w-3xl font-heading text-3xl leading-tight font-semibold text-white md:text-5xl"
      >
        {copy.name}
      </h1>
      <p class="text-shadow-photo mt-3 text-lg text-white/85">{copy.route}</p>
      <p class="text-shadow-photo mt-4 max-w-2xl text-white/90">{copy.summary}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-primary px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-black/25 transition-colors hover:bg-secondary"
        >
          <Icon name="tabler:brand-whatsapp" class="h-5 w-5" aria-hidden="true" />
          {d.common.whatsapp}
        </a>
        <p class="text-shadow-photo font-heading text-lg font-semibold text-white">
          {
            tour.price === null ? (
              d.common.onRequest
            ) : (
              <>
                <span class="text-sm font-medium text-white/80">{d.common.from}</span>{' '}
                <span dir="ltr">
                  {tour.price}
                  {BUSINESS.currencySymbol}
                </span>{' '}
                <span class="text-sm font-medium text-white/80">{d.common.perPerson}</span>
              </>
            )
          }
        </p>
      </div>
    </div>
  </header>

  <div class="mx-auto max-w-7xl px-4 py-14 md:px-6 md:py-20">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7 xl:col-span-8">
        <h2 class="font-heading text-2xl font-semibold text-heading md:text-3xl">{d.common.itinerary}</h2>

        <ol class="mt-8 space-y-8">
          {
            copy.days.map((day, index) => (
              <li class="relative ps-10">
                <span
                  class="absolute start-0 top-0 inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary font-heading text-sm font-semibold text-white"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                {index < copy.days.length - 1 && (
                  <span class="absolute start-4 top-9 bottom-[-2rem] w-px bg-sand-border" aria-hidden="true" />
                )}

                <h3 class="font-heading text-lg font-semibold text-heading">{day.title}</h3>
                <ul class="mt-3 space-y-1.5">
                  {day.bullets.map((bullet) => (
                    <li class="flex gap-2 text-default">
                      <Icon
                        name="tabler:point-filled"
                        class="mt-1.5 h-3 w-3 shrink-0 text-primary/60"
                        aria-hidden="true"
                      />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
                {day.overnight && (
                  <p class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-sand px-3 py-1 text-sm text-default">
                    <Icon name="tabler:moon-stars" class="h-4 w-4 text-primary" aria-hidden="true" />
                    {d.common.overnight} {day.overnight}
                  </p>
                )}
              </li>
            ))
          }
        </ol>

        {
          copy.note && (
            <aside class="mt-10 flex gap-3 rounded-2xl border border-primary/30 bg-primary/5 p-5">
              <Icon name="tabler:info-circle" class="mt-0.5 h-5 w-5 shrink-0 text-primary" aria-hidden="true" />
              <div>
                <h3 class="font-semibold text-heading">{d.common.goodToKnow}</h3>
                <p class="mt-1 text-sm text-default">{copy.note}</p>
              </div>
            </aside>
          )
        }

        <div class="mt-10 grid gap-3 sm:grid-cols-4">
          {
            tour.gallery.map((photo, index) => (
              <Image
                src={photo}
                alt=""
                layout="cover"
                widths={[240, 480]}
                sizes="(max-width: 639px) 100vw, 240px"
                format="webp"
                class:list={['aspect-[4/3] w-full rounded-xl object-cover', index > 1 ? 'hidden sm:block' : '']}
              />
            ))
          }
        </div>
      </div>

      <aside class="lg:col-span-5 xl:col-span-4">
        <div class="lg:sticky lg:top-24">
          <div class="rounded-2xl border border-sand bg-sand p-6">
            <h2 class="flex items-center gap-2 font-heading text-lg font-semibold text-heading">
              <Icon name="tabler:circle-check" class="h-5 w-5 text-primary" aria-hidden="true" />
              {d.common.included}
            </h2>
            <ul class="mt-3 space-y-1.5 text-sm text-default">
              {
                copy.included.map((item) => (
                  <li class="flex gap-2">
                    <Icon name="tabler:check" class="mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true" />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>

            <h2 class="mt-6 flex items-center gap-2 font-heading text-lg font-semibold text-heading">
              <Icon name="tabler:circle-x" class="h-5 w-5 text-muted" aria-hidden="true" />
              {d.common.notIncluded}
            </h2>
            <ul class="mt-3 space-y-1.5 text-sm text-muted">
              {
                copy.notIncluded.map((item) => (
                  <li class="flex gap-2">
                    <Icon name="tabler:minus" class="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true" />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>

            <a
              href={whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-primary px-5 py-3 text-base font-semibold text-white transition-colors hover:bg-secondary"
            >
              <Icon name="tabler:brand-whatsapp" class="h-5 w-5" aria-hidden="true" />
              {d.common.bookNow}
            </a>
          </div>

          <div class="mt-6 rounded-2xl border border-sand p-6">
            <h2 class="font-heading text-lg font-semibold text-heading">{d.common.otherTours}</h2>
            <ul class="mt-3 space-y-3">
              {
                others.map((other) => (
                  <li>
                    <a href={tourPath(other.id, lang)} class="group flex gap-3">
                      <Image
                        src={other.image}
                        alt=""
                        layout="cover"
                        widths={[80, 160]}
                        sizes="80px"
                        format="webp"
                        class="h-16 w-20 shrink-0 rounded-lg object-cover"
                      />
                      <span>
                        <span class="block font-medium text-heading transition-colors group-hover:text-primary">
                          {d.tours.items[other.id].shortName}
                        </span>
                        <span class="block text-sm text-muted">{d.tours.items[other.id].duration}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <CtaBand lang={lang} message={fillTemplate(d.common.whatsappMessage, { tour: copy.name })} />
</article>
